COMPOSE_PROJECT_NAME=db2-weapons
DB2_SWARM_DATA_DIR=/home/pc/swarm_data
DB2_SCRIPTS_DIR=/home/pc/scripts
DB2_REPORTS_DIR=/home/pc/reports
DB2_PROXY_URL=http://192.168.8.1:7890
DB2_WORKER_PROFILE=safe
DB2_WORKER_EXECUTE=0
DB2_WRITER_EXECUTE=0
DB2_WRITE_LOCK=/db2-data/.db_write.lock
DB2_WRITE_SPOOL_DIR=/home/pc/swarm_data/write_spool
DB2_WRITE_SPOOL=/db2-spool
DB2_SIDECAR_CACHE_DIR=/home/pc/swarm_data/cache
DB2_SIDECAR_CACHE_DB=/db2-cache/db2_sidecar_cache.sqlite
DB2_AVATAR_OUTPUT_HOST_DIR=/home/pc/swarm_data/output/avatars
DB2_AVATAR_OUTPUT_DIR=/db2-avatar-output
DB2_AVATAR_LOCAL_PATH_PREFIX=/home/pc/swarm_data/output/avatars
DB2_LIGHTPANDA_PORT=9222
DB2_LIGHTPANDA_CDP_URL=http://db2-lightpanda:9222
DB2_AI_DATA_ROOT=/mnt/e/ai
