# HUAIDJ Weekly CloudRun Environment Template
# Copy this file to .env and fill in real values
# WARNING: .env contains real secrets and MUST NOT be committed to Git

# DeepSeek API (required for LLM enrichment)
DEEPSEEK_API_KEY=<SET_IN_ENV>
DEEPSEEK_ENRICH_ENABLED=false
DEEPSEEK_MODEL=deepseek-v4-pro

# CloudBase (Tencent Cloud)
CLOUDBASE_ENV_ID=<SET_IN_ENV>
CLOUDRUN_SERVICE_NAME=weekly-api

# Weekly API settings
WEEKLY_ACTIVITY_API_DIR=/app/data/current_release
PORT=8787
WEEKLY_CRON_SCHEDULE=0 2 * * 1

# Django-style (if backend uses Django)
DJANGO_SECRET_KEY=<SET_IN_ENV>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# WeChat Mini Program
WECHAT_APP_ID=<SET_IN_ENV>
WECHAT_APP_SECRET=<SET_IN_ENV>

# Database
DATABASE_URL=<SET_IN_ENV>

# Redis / Cache
REDIS_URL=<SET_IN_ENV>

# Object Storage
STORAGE_ACCESS_KEY=<SET_IN_ENV>
STORAGE_SECRET_KEY=<SET_IN_ENV>
