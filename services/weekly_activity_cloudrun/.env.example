# =============================================================================
# HUAIDJ Weekly Activity Miniprogram — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# --- DeepSeek AI (LLM enrichment) ---
# API key for DeepSeek Flash API. Used for DJ lineup analysis, venue entity
# extraction, music style classification, and event description enhancement.
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Override the base URL (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model to use for enrichment (default: deepseek-v4-flash)
# DEEPSEEK_MODEL=deepseek-v4-flash

# Timeout in milliseconds (default: 45000)
# DEEPSEEK_TIMEOUT_MS=45000
# Maximum accepted provider response envelope (default: 524288; hard cap: 2097152)
# DEEPSEEK_RESPONSE_MAX_BYTES=524288

# Allow LLM enrichment in production (set to "true" to enable)
# DEEPSEEK_ENRICH_ENABLED=false

# --- CloudBase / Tencent Cloud ---
# CloudBase environment ID (personal edition, expires 2026-06-09)
CLOUDBASE_ENV_ID=huaidjweekly-d8g1go7-d0a07863e3e

# CloudRun service name
CLOUDRUN_SERVICE_NAME=weekly-api

# Service port (CloudRun internal, default: 8787)
PORT=8787

# --- Private sound submissions ---
# Production writes are disabled unless this durable backend is explicitly set.
# Create the collection first and grant this CloudRun service write access.
SOUND_SUBMISSIONS_BACKEND=cloudbase
SOUND_SUBMISSIONS_COLLECTION=weekly_sound_submissions
SOUND_SUBMISSIONS_MAX_PER_DAY=5

# The mini-program never calls this POST directly. A mini-program-only Cloud
# Function derives the trusted identity, signs the fixed request, then calls
# CloudRun. Use the same secret in CloudRun and soundSubmissionGateway only.
SOUND_SUBMISSIONS_INGRESS_MODE=hmac_gateway
SOUND_SUBMISSIONS_INGRESS_HMAC_SECRET=

# Private reviewer access; never place this token in the mini-program package.
WEEKLY_REVIEW_ADMIN_TOKEN=
SOUND_REVIEW_ENRICH_ENABLED=false

# Sound review vision runs on actual downloaded sound-system images. Payment
# evidence is never sent to either model.
DASHSCOPE_API_KEY=
QWEN_VL_MODEL=qwen3-vl-plus
# QWEN_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_VL_TIMEOUT_MS=60000
# QWEN_VL_MAX_TOKENS=1600
# QWEN_VL_RESPONSE_MAX_BYTES=262144
# SOUND_EVIDENCE_DOWNLOAD_TIMEOUT_MS=15000

# SOUND_SUBMISSIONS_DIR is local development only. It is intentionally rejected
# as a production backend because multiple CloudRun instances can overwrite it.
# SOUND_SUBMISSIONS_DIR=./data/sounds

# --- WeChat Mini Program ---
# AppID for the mini program
WECHAT_APP_ID=wx0bc0a1d9d892af2d

# Path to WeChat DevTools CLI (Windows)
# WECHAT_DEVTOOLS_CLI_PATH=C:\Program Files (x86)\Tencent\微信web开发者工具\cli.bat

# --- Data Pipeline ---
# Root directory for weekly release data
# WEEKLY_ACTIVITY_API_DIR=./data/current_release

# Directory for source URL mappings
# WEEKLY_ACTIVITY_SOURCE_MAP_DIR=./data/source_actions

# --- Docker / Automation ---
# Cron schedule for weekly data refresh (cron expression)
# Default: every Monday at 02:00 UTC
WEEKLY_CRON_SCHEDULE=0 2 * * 1

# Path to downstream results on the host
# DOWNSTREAM_RESULTS_DIR=D:\downstream_results\stage7_rewrite\longrun

# --- OpenClaw Integration ---
# OpenClaw API base URL for task scheduling
# OPENCLAW_API_URL=http://localhost:18789

# OpenClaw auth token
# OPENCLAW_AUTH_TOKEN=
