# =============================================================================
# HUAIDJ Weekly Activity Miniprogram — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# --- DeepSeek AI (LLM enrichment) ---
# API key for DeepSeek Flash API. Used for DJ lineup analysis, venue entity
# extraction, music style classification, and event description enhancement.
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Override the base URL (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model to use for enrichment (default: deepseek-v4-flash)
# DEEPSEEK_MODEL=deepseek-v4-flash

# Timeout in milliseconds (default: 45000)
# DEEPSEEK_TIMEOUT_MS=45000

# Allow LLM enrichment in production (set to "true" to enable)
# DEEPSEEK_ENRICH_ENABLED=false

# --- CloudBase / Tencent Cloud ---
# CloudBase environment ID (personal edition, expires 2026-06-09)
CLOUDBASE_ENV_ID=huaidjweekly-d8g1go7-d0a07863e3e

# CloudRun service name
CLOUDRUN_SERVICE_NAME=weekly-api

# Service port (CloudRun internal, default: 8787)
PORT=8787

# --- WeChat Mini Program ---
# AppID for the mini program
WECHAT_APP_ID=wx0bc0a1d9d892af2d

# Path to WeChat DevTools CLI (Windows)
# WECHAT_DEVTOOLS_CLI_PATH=C:\Program Files (x86)\Tencent\微信web开发者工具\cli.bat

# --- Data Pipeline ---
# Root directory for weekly release data
# WEEKLY_ACTIVITY_API_DIR=./data/current_release

# Directory for source URL mappings
# WEEKLY_ACTIVITY_SOURCE_MAP_DIR=./data/source_actions

# --- Docker / Automation ---
# Cron schedule for weekly data refresh (cron expression)
# Default: every Monday at 02:00 UTC
WEEKLY_CRON_SCHEDULE=0 2 * * 1

# Path to downstream results on the host
# DOWNSTREAM_RESULTS_DIR=D:\downstream_results\stage7_rewrite\longrun

# --- OpenClaw Integration ---
# OpenClaw API base URL for task scheduling
# OPENCLAW_API_URL=http://localhost:18789

# OpenClaw auth token
# OPENCLAW_AUTH_TOKEN=
