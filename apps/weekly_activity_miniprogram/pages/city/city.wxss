.city-page {
  padding-top: 46rpx;
}

.guide-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 44rpx;
}

.brand-logo {
  width: 118rpx;
  height: 36rpx;
  opacity: .86;
}

.guide-top-action,
.change-city {
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 6rpx;
  color: #a7ff26;
  background: rgba(255,255,255,.035);
  font-size: 22rpx;
  line-height: 1.2;
}

.guide-header {
  margin-bottom: 38rpx;
}

.guide-title {
  margin-top: 12rpx;
  color: #f1efdd;
  font-size: 48rpx;
  line-height: 1.1;
  font-weight: 800;
}

.guide-intro {
  max-width: 560rpx;
  margin-top: 18rpx;
  color: rgba(255,255,255,.58);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 26rpx;
  line-height: 1.62;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 0 18rpx;
}

.section-count {
  color: rgba(255,255,255,.38);
  font-size: 22rpx;
}

.city-select-panel,
.guide-workbench {
  padding-bottom: 44rpx;
}

.city-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.city-card {
  min-height: 116rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255,255,255,.075);
  border-radius: 8rpx;
  background: rgba(255,255,255,.035);
  box-sizing: border-box;
}

.city-name {
  color: #f2eedf;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 700;
}

.city-count {
  margin-top: 12rpx;
  color: rgba(255,255,255,.46);
  font-size: 22rpx;
  line-height: 1.3;
}

.city-summary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
  padding: 24rpx 0 22rpx;
  border-top: 1rpx solid rgba(255,255,255,.08);
  border-bottom: 1rpx solid rgba(255,255,255,.08);
}

.city-kicker,
.decision-label {
  color: #a7ff26;
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.city-heading {
  margin-top: 8rpx;
  color: #f4f1dd;
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 800;
}

.city-stats {
  margin-top: 10rpx;
  color: rgba(255,255,255,.5);
  font-size: 23rpx;
  line-height: 1.35;
}

.decision-section,
.venue-section {
  margin-top: 30rpx;
}

.decision-card {
  padding: 22rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid rgba(255,255,255,.075);
  border-radius: 8rpx;
  background: rgba(255,255,255,.04);
}

.decision-title {
  margin-top: 12rpx;
  color: #f1efdd;
  font-size: 30rpx;
  line-height: 1.36;
  font-weight: 700;
}

.decision-meta {
  margin-top: 10rpx;
  color: rgba(255,255,255,.58);
  font-size: 23rpx;
  line-height: 1.45;
}

.decision-reason {
  margin-top: 12rpx;
  padding-left: 14rpx;
  border-left: 3rpx solid rgba(126,184,218,.7);
  color: rgba(255,255,255,.52);
  font-size: 22rpx;
  line-height: 1.5;
}

.compact-state {
  padding: 34rpx 0;
}

.venue-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.venue-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 84rpx;
  padding: 16rpx 18rpx;
  border-radius: 7rpx;
  background: rgba(255,255,255,.035);
}

.venue-name {
  color: #e8e3d0;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 650;
}

.venue-meta {
  margin-top: 4rpx;
  color: rgba(255,255,255,.42);
  font-size: 21rpx;
  line-height: 1.3;
}

.venue-arrow {
  flex-shrink: 0;
  color: rgba(255,255,255,.34);
  font-size: 34rpx;
}

.guide-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 34rpx;
}

.guide-action {
  width: 100%;
  height: 76rpx;
  margin: 0;
  border: 1rpx solid rgba(255,255,255,.1);
  border-radius: 7rpx;
  background: rgba(255,255,255,.045);
  color: #d9d6c6;
  font-size: 25rpx;
  line-height: 76rpx;
}

.decision-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.decision-tag {
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(255,255,255,.13);
  border-radius: 24rpx;
  background: rgba(255,255,255,.04);
  color: rgba(255,255,255,.65);
  font-size: 20rpx;
  line-height: 1.35;
}

.decision-night-type {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,.40);
  font-style: italic;
  line-height: 1.4;
}

.guide-action.primary {
  border-color: rgba(167,255,38,.38);
  background: rgba(167,255,38,.08);
  color: #a7ff26;
}
