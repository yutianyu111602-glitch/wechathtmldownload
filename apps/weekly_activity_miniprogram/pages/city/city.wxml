<view class="page city-page">
  <view class="sub-nav">
    <button bindtap="goBack">{{t.back}}</button>
  </view>
  <image lazy-load class="brand-logo" src="/assets/brand/huaidj-logo-nav-512x128.png" mode="aspectFit" ></image>
  <view class="section-title">{{t.title}}</view>
  <view class="muted intro">{{t.intro}}</view>

  <view wx:if="{{loading}}" class="state">{{t.loading}}</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>
  <view wx:elif="{{cities.length === 0}}" class="state">{{t.empty}}</view>
  <view wx:else class="city-grid">
    <view
      wx:for="{{cities}}"
      wx:key="city_key"
      class="city-card"
      data-key="{{item.city_key}}"
      bindtap="openCity"
      hover-class="option-hover"
    >
      <view class="city-name">{{item.displayCity}}</view>
      <view class="city-count">{{item.item_count}} {{t.eventCount}}</view>
    </view>
  </view>
</view>
