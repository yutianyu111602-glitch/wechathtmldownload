.about-page {
  padding-top: 46rpx;
}

.brand-logo {
  width: 118rpx;
  height: 36rpx;
  margin-bottom: 64rpx;
  opacity: .86;
}

.copy {
  max-width: 560rpx;
  margin-top: 28rpx;
  color: rgba(255,255,255,.58);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.68;
}

.sound-panel {
  margin-top: 42rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 8rpx;
  background: rgba(255,255,255,.035);
}

.sound-panel-hover {
  background: rgba(255,255,255,.07);
}

.sound-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.sound-panel-title {
  color: rgba(255,255,255,.92);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 30rpx;
  font-weight: 680;
  line-height: 1.34;
}

.soundNoticeUnread {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff3b30;
  flex: 0 0 auto;
}

.sound-full-access {
  margin-top: 18rpx;
  color: rgba(255,255,255,.68);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 25rpx;
  line-height: 1.62;
}

.sound-review-note {
  margin-top: 16rpx;
  color: rgba(255,255,255,.48);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 23rpx;
  line-height: 1.56;
}

.interview-panel {
  margin-top: 42rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid rgba(182,255,59,.24);
  border-radius: 8rpx;
  background: linear-gradient(180deg, rgba(182,255,59,.08), rgba(255,255,255,.025));
}

.interview-panel-hover {
  background: rgba(182,255,59,.11);
}

.ai-helper-panel {
  margin-top: 42rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid rgba(126, 184, 218, .28);
  border-radius: 8rpx;
  background: rgba(126, 184, 218, .055);
}

.ai-helper-panel-hover {
  background: rgba(126, 184, 218, .10);
}

.ai-helper-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.ai-helper-kicker {
  color: rgba(126, 184, 218, .86);
  font-family: "JetBrains Mono", "SF Mono", Consolas, monospace;
  font-size: 20rpx;
  letter-spacing: 0;
  text-transform: uppercase;
}

.ai-helper-title {
  margin-top: 8rpx;
  color: rgba(255,255,255,.94);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 32rpx;
  font-weight: 680;
  line-height: 1.3;
}

.ai-helper-copy {
  margin-top: 18rpx;
  color: rgba(255,255,255,.66);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 26rpx;
  line-height: 1.64;
}

.ai-helper-hint {
  margin-top: 14rpx;
  color: rgba(255,255,255,.44);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 23rpx;
  line-height: 1.56;
}

.interview-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.interview-kicker {
  color: rgba(182,255,59,.82);
  font-family: "JetBrains Mono", "SF Mono", Consolas, monospace;
  font-size: 20rpx;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.interview-title {
  margin-top: 10rpx;
  color: rgba(255,255,255,.94);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 34rpx;
  font-weight: 760;
  line-height: 1.26;
}

.interview-arrow {
  color: rgba(182,255,59,.86);
  font-size: 30rpx;
  line-height: 1;
}

.interview-copy {
  margin-top: 20rpx;
  color: rgba(255,255,255,.68);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 26rpx;
  line-height: 1.62;
}

.interview-meta {
  margin-top: 16rpx;
  color: rgba(255,255,255,.46);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 23rpx;
  line-height: 1.56;
}

.atlas-panel {
  margin-top: 46rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid rgba(126, 184, 218, .24);
  border-radius: 8rpx;
  background: rgba(126, 184, 218, .055);
}

.atlas-panel-hover {
  background: rgba(126, 184, 218, .10);
}

.atlas-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.atlas-kicker {
  color: rgba(126, 184, 218, .86);
  font-family: "JetBrains Mono", "SF Mono", Consolas, monospace;
  font-size: 20rpx;
  letter-spacing: 0;
  text-transform: uppercase;
}

.atlas-title {
  margin-top: 8rpx;
  color: rgba(255,255,255,.94);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 32rpx;
  font-weight: 680;
  line-height: 1.3;
}

.atlas-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 0 0 auto;
  color: rgba(126, 184, 218, .86);
  font-family: "JetBrains Mono", "SF Mono", Consolas, monospace;
  font-size: 20rpx;
  line-height: 1.2;
}

.atlas-arrow {
  color: rgba(255,255,255,.76);
  font-size: 24rpx;
}

.atlas-copy {
  color: rgba(255,255,255,.66);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 26rpx;
  line-height: 1.64;
}

.atlas-meta {
  margin-top: 18rpx;
  color: rgba(255,255,255,.48);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 24rpx;
  line-height: 1.56;
}

.atlas-disclaimer {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-left: 3rpx solid rgba(126, 184, 218, .48);
  background: rgba(0,0,0,.18);
  color: rgba(255,255,255,.54);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 23rpx;
  line-height: 1.56;
}

.atlas-link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,.07);
  color: rgba(255,255,255,.84);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 25rpx;
}

.atlas-url {
  color: rgba(126, 184, 218, .92);
  font-family: "JetBrains Mono", "SF Mono", Consolas, monospace;
  font-size: 23rpx;
}

.meta-block {
  margin-top: 40rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 8rpx;
  background: rgba(255,255,255,.03);
}

.meta-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,.06);
  color: rgba(255,255,255,.72);
  font-size: 24rpx;
}

.meta-line:last-child {
  border-bottom: 0;
}

.env-link {
  color: #7eb8da;
  font-family: "JetBrains Mono", "SF Mono", Consolas, monospace;
  font-size: 24rpx;
}
