.detail-page {
  padding: 0 0 150rpx;
  background: #070807;
}

.loading-state {
  padding: 160rpx 40rpx 0;
  color: rgba(233,229,207,.72);
  font-size: 28rpx;
  line-height: 1.4;
}

.state-progress {
  width: 100%;
  height: 6rpx;
  margin-top: 26rpx;
  background: rgba(255,255,255,.06);
  overflow: hidden;
}

.state-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #b6ff3b 0%, #7b4bd8 100%);
  transition: width .18s ease;
}

.detail-nav {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 92rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid rgba(182,255,59,.07);
  background: rgba(7,8,7,.96);
}

.back-button,
.share-button {
  margin: 0;
  padding: 0;
  color: rgba(233,229,207,0.40);
  background: transparent;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: .12em;
}

.icon-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.action-icon {
  width: 26rpx;
  height: 26rpx;
  flex: 0 0 auto;
}

.event-hero {
  padding: 40rpx 32rpx 34rpx;
  border-bottom: 1rpx solid rgba(182,255,59,.07);
}

.detail-logo {
  width: 118rpx;
  height: 36rpx;
  opacity: .84;
}

.detail-meta-line {
  margin-top: 34rpx;
  color: rgba(182,255,59,.48);
  font-size: 24rpx;
  line-height: 1.3;
  letter-spacing: .06em;
}

.detail-title {
  margin-top: 18rpx;
  color: #e9e5cf;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 42rpx;
  line-height: 1.16;
  font-weight: 720;
  letter-spacing: 0;
}

.hero-save {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 132rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 4rpx;
  color: #b6ff3b;
  background: rgba(48,32,74,.38);
  font-size: 24rpx;
  line-height: 56rpx;
  letter-spacing: .08em;
}

.hero-save .action-icon {
  width: 24rpx;
  height: 24rpx;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 32rpx;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  min-height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
  border-radius: 4rpx;
  color: rgba(233,229,207,.62);
  background: #11150f;
  font-size: 24rpx;
  line-height: 1.2;
  letter-spacing: .06em;
  box-sizing: border-box;
}

.poster-hero {
  padding: 0 32rpx;
  background: #070807;
}

.detail-poster {
  display: block;
  width: 100%;
  margin-top: 30rpx;
  border: 1rpx solid rgba(182,255,59,0.10);
  border-radius: 4rpx;
  box-sizing: border-box;
}

.detail-poster-fallback {
  display: flex;
  align-items: flex-end;
  min-height: 420rpx;
  margin-top: 30rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.05);
  border-radius: 4rpx;
  color: #e9e5cf;
  background:
    linear-gradient(rgba(255,255,255,.035) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255,255,255,.035) 1rpx, transparent 1rpx),
    #080b07;
  background-size: 42rpx 42rpx;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 34rpx;
  line-height: 1.18;
  font-weight: 720;
  box-sizing: border-box;
}

.fact-strip {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rpx;
  margin: 0 32rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
  background: linear-gradient(180deg, #11150f 0%, #0b0d0a 100%);
}

.fact-cell {
  min-width: 0;
  min-height: 144rpx;
  padding: 26rpx 20rpx 24rpx;
  background: #080b07;
  box-sizing: border-box;
}

.fact-kicker,
.address-label,
.summary-kicker {
  color: rgba(233,229,207,0.38);
  font-size: 24rpx;
  line-height: 1.2;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.fact-date-main {
  color: #b6ff3b;
  font-size: 40rpx;
}

.fact-main {
  margin-top: 16rpx;
  color: rgba(233,229,207,.84);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.24;
  font-weight: 650;
  word-break: break-word;
}

.fact-sub {
  margin-top: 10rpx;
  color: rgba(233,229,207,0.42);
  font-size: 24rpx;
  line-height: 1.25;
}

.address-block {
  margin: 0 32rpx;
  padding: 26rpx 0 28rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.address-value {
  margin-top: 14rpx;
  color: rgba(233,229,207,.72);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 26rpx;
  line-height: 1.45;
  word-break: break-word;
}

.copy-hint {
  margin-top: 12rpx;
  color: #8fdc65;
  font-size: 24rpx;
  letter-spacing: .04em;
}

.summary-strip {
  margin: 0 32rpx;
  padding: 26rpx 0 0;
}

.summary-cell {
  padding-bottom: 8rpx;
}

.summary-value {
  margin-top: 14rpx;
  color: rgba(233,229,207,.68);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 26rpx;
  line-height: 1.42;
}

.detail-section {
  padding: 58rpx 32rpx 0;
}

.detail-heading {
  margin-bottom: 26rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
  color: rgba(233,229,207,.88);
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.detail-heading::before {
  display: inline-block;
  width: 6rpx;
  height: 6rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #b6ff3b;
  vertical-align: 4rpx;
  content: "";
}

.lineup-line {
  color: #e9e5cf;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.42;
}

.artist-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
  color: #e9e5cf;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 30rpx;
  line-height: 1;
  font-weight: 700;
}

.atlas-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.atlas-row-main {
  min-width: 0;
}

.atlas-name {
  color: #e9e5cf;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 700;
  word-break: break-word;
}

.atlas-raw {
  margin-top: 8rpx;
  color: rgba(233,229,207,.42);
  font-size: 23rpx;
  line-height: 1.25;
  word-break: break-word;
}

.atlas-badge {
  flex: 0 0 auto;
  min-width: 90rpx;
  padding: 8rpx 10rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 4rpx;
  color: rgba(233,229,207,.66);
  background: #11150f;
  font-size: 20rpx;
  line-height: 1;
  text-align: center;
  letter-spacing: .08em;
}

.atlas-badge.is-verified {
  color: #b6ff3b;
  background: rgba(40,70,20,.38);
}

.atlas-badge.is-hint {
  color: rgba(233,229,207,.68);
}

.source-article-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.source-article-main {
  min-width: 0;
}

.source-article-title {
  color: #b8ff72;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.24;
  font-weight: 760;
  word-break: break-word;
}

.source-article-meta {
  margin-top: 10rpx;
  color: rgba(255,255,255,0.5);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 23rpx;
  line-height: 1.38;
}

.source-article-badge {
  flex: 0 0 auto;
  padding: 8rpx 10rpx;
  border: 1rpx solid rgba(182,255,59,.16);
  border-radius: 4rpx;
  color: #b6ff3b;
  background: rgba(40,70,20,.30);
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: .08em;
}

.chevron {
  color: rgba(255,255,255,0.32);
  font-size: 44rpx;
  font-weight: 300;
}

.description-line {
  margin-bottom: 26rpx;
  color: rgba(233,229,207,.72);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.58;
}

.muted-line {
  color: rgba(143,220,101,.62);
}

.description-fact {
  margin-top: 34rpx;
  color: rgba(233,229,207,.72);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.48;
}

.fact-label {
  display: block;
  margin-bottom: 10rpx;
  color: #8fdc65;
  font-family: "JetBrains Mono", "SF Mono", Consolas, monospace;
  font-size: 24rpx;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.description-fact view {
  margin-top: 6rpx;
}

.bottom-action {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  z-index: 6;
}

.bottom-action button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 78rpx;
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 4rpx;
  color: #e9e5cf;
  background: linear-gradient(180deg, #11150f 0%, #0b0d0a 100%);
  font-size: 26rpx;
  line-height: 78rpx;
  letter-spacing: .08em;
}
