<view class="page detail-page">
  <view wx:if="{{loading}}" class="state loading-state">
    <view>{{loadingStep || t.loading}}</view>
    <view class="state-progress">
      <view class="state-progress-fill" style="width: {{loadingProgress}}%;"></view>
    </view>
  </view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>
  <view wx:elif="{{!item}}" class="state">{{t.notFound}}</view>
  <view wx:else>
    <view class="detail-nav">
      <button class="back-button" bindtap="goBack">{{t.back}}</button>
      <button class="share-button icon-button" open-type="share">
        <image lazy-load class="action-icon" src="/assets/icons/share.png" mode="aspectFit" ></image>
        <text>{{t.share}}</text>
      </button>
    </view>

    <view class="event-hero">
      <image lazy-load class="detail-logo" src="/assets/brand/huaidj-logo-nav-512x128.png" mode="aspectFit" ></image>
      <view wx:if="{{!item.isSourceOverview && item.detailMetaLine}}" class="detail-meta-line">{{item.detailMetaLine}}</view>
      <view class="detail-title">{{item.displayTitle}}</view>
      <view class="hero-actions">
        <button class="hero-save icon-button" bindtap="saveItem">
          <image lazy-load class="action-icon" src="{{saved ? '/assets/icons/favorite-active.png' : '/assets/icons/favorite.png'}}" mode="aspectFit" ></image>
          <text>{{saved ? t.saved : t.save}}</text>
        </button>
        <view wx:if="{{item.hasStyle}}" class="hero-tag">{{item.styleLabel}}</view>
        <view wx:if="{{item.hasSoundSystem}}" class="hero-tag">{{item.soundSystemLabel}}</view>
        <view wx:if="{{priceLabel}}" class="hero-tag">{{priceLabel}}</view>
      </view>
    </view>

    <view wx:if="{{!item.isSourceOverview}}" class="fact-strip">
      <view class="fact-cell">
        <view class="fact-kicker">{{t.date}}</view>
        <view class="fact-main fact-date-main">{{item.weekdayLabel}} {{item.dateRangeCompact || item.dateCompact}}</view>
        <view wx:if="{{item.isCalendarPreview}}" class="fact-sub calendar-preview-note">{{item.calendarPreviewLabel}}</view>
        <view wx:if="{{item.hasTime}}" class="fact-sub">{{item.timeLabel}}</view>
      </view>
      <view class="fact-cell club-cell" bindtap="openVenue" hover-class="option-hover">
        <view class="fact-kicker">{{t.club}}</view>
        <view class="club-row">
          <view class="club-main-wrap">
            <view class="fact-main club-main">{{item.venueLabel || item.promoter || item.account}}</view>
            <view wx:if="{{item.cityLabel}}" class="fact-sub club-sub">{{item.cityLabel}}</view>
            <view class="club-action">{{t.clubSchedule}}</view>
          </view>
          <text class="club-chevron">›</text>
        </view>
      </view>
    </view>

    <view wx:if="{{item.hasAddress}}" class="address-block" bindtap="handleAddressTap">
      <view class="address-header">
        <view class="address-label">{{t.address}}</view>
        <view class="address-action">{{t.openMap}} ›</view>
      </view>
      <view class="address-value">{{item.addressLabel}}</view>
    </view>

    <view wx:if="{{item.hasLineup || item.hasLineupHint || item.hasDescription || item.hasBio}}" class="summary-strip">
      <view wx:if="{{item.hasLineup}}" class="summary-cell summary-entity-cell">
        <view class="summary-kicker">{{t.artists}}</view>
        <view class="lineup-chip-list">
          <view
            wx:for="{{item.lineupItems}}"
            wx:key="*this"
            class="lineup-chip"
            data-name="{{item}}"
            bindtap="openArtist"
            hover-class="option-hover"
          >
            <text class="lineup-chip-name">{{item}}</text>
            <text class="lineup-chip-arrow">›</text>
          </view>
        </view>
      </view>
      <view wx:elif="{{item.hasLineupHint}}" class="summary-cell">
        <view class="summary-kicker">{{t.lineup}}</view>
        <view class="summary-value muted-line">{{t.lineupHint}}</view>
      </view>
      <view wx:elif="{{item.hasDescription || item.hasBio}}" class="summary-cell">
        <view class="summary-kicker">{{t.description}}</view>
        <view class="summary-value">{{item.descriptionLead || item.displayTitle}}</view>
      </view>
    </view>

    <view class="poster-hero" bindtap="openPoster" hover-class="poster-hover">
      <image
        lazy-load
        wx:if="{{item.coverUrl && !posterLoadFailed}}"
        class="detail-poster"
        src="{{item.coverUrl}}"
        mode="widthFix"
        bindload="onPosterImageLoad"
        binderror="onPosterImageError"
      ></image>
      <view wx:else class="detail-poster-fallback">{{item.displayTitle}}</view>
      <view wx:if="{{item.hasSource}}" class="tap-hint" catchtap="openSource">{{sourceLoading ? t.sourcePreparing : t.viewSource}} ›</view>
    </view>

    <view wx:if="{{!item.isSourceOverview && item.sourceArticles.length}}" class="detail-section">
      <view class="detail-heading">{{t.sourceArticles}}</view>
      <view
        wx:for="{{item.sourceArticles}}"
        wx:key="id"
        class="source-article-row"
        data-hash="{{item.hash}}"
        bindtap="openSourceArticle"
      >
        <view class="source-article-main">
          <view class="source-article-title">{{item.title}}</view>
          <view class="source-article-meta">{{item.subtitle}}</view>
        </view>
        <text wx:if="{{item.isPrimary}}" class="source-article-badge">{{t.primary}}</text>
        <text wx:else class="chevron">›</text>
      </view>
    </view>

    <view wx:if="{{item.hasLineup}}" class="detail-section">
      <view class="detail-heading">{{t.lineup}}</view>
      <view wx:for="{{item.lineupItems}}" wx:key="*this" class="lineup-line">{{item}}</view>
    </view>
    <view wx:elif="{{item.hasLineupHint}}" class="detail-section">
      <view class="detail-heading">{{t.lineup}}</view>
      <view class="description-line muted-line">{{t.lineupHint}}</view>
    </view>

    <view wx:if="{{item.hasPrice}}" class="detail-section ticket-section">
      <view class="detail-heading">{{t.ticketing}}</view>
      <view wx:for="{{item.price}}" wx:key="*this" class="ticket-line">{{item}}</view>
    </view>

    <view wx:if="{{item.hasLineup}}" class="detail-section">
      <view class="detail-heading">{{t.artists}}</view>
      <view wx:for="{{item.lineupItems}}" wx:key="*this" class="artist-row" data-name="{{item}}" bindtap="openArtist">
        <view class="artist-row-main">
          <text class="artist-name">{{item}}</text>
        </view>
        <text class="chevron">›</text>
      </view>
    </view>

    <view wx:if="{{item.hasAtlasArtistItems}}" class="detail-section">
      <view class="detail-heading">{{t.atlas}}</view>
      <view wx:for="{{item.atlasArtistItems}}" wx:key="raw" class="atlas-row" data-name="{{item.name}}" bindtap="openArtist">
        <view class="atlas-row-main">
          <view class="atlas-name">{{item.name}}</view>
          <view wx:if="{{item.raw && item.raw !== item.name}}" class="atlas-raw">{{item.raw}}</view>
          <view wx:if="{{item.isHint && item.hintLabel}}" class="atlas-raw">{{item.hintLabel}}</view>
        </view>
        <view class="atlas-badge {{item.isVerified ? 'is-verified' : 'is-hint'}}">
          {{item.isVerified ? t.atlasVerified : t.atlasHint}}
        </view>
      </view>
    </view>

    <view wx:if="{{!item.isSourceOverview}}" class="detail-section">
      <view class="detail-heading">{{t.description}}</view>
      <view wx:if="{{item.hasDescription}}">
        <view wx:for="{{item.descriptionLines}}" wx:key="*this" class="description-line">{{item}}</view>
      </view>
      <view wx:elif="{{item.hasBio}}">
        <view wx:for="{{item.bioLines}}" wx:key="*this" class="description-line">{{item}}</view>
      </view>
      <view wx:else class="description-line muted-line">
        {{item.displayTitle}}
      </view>
    </view>

    <view wx:if="{{item.hasDjDiscovery}}" class="detail-section dj-discovery-section">
      <view class="detail-heading">{{t.djDiscovery}}</view>
      <view
        wx:for="{{item.djDiscoverySections}}"
        wx:for-item="section"
        wx:key="nameKey"
        class="dj-discovery-block"
      >
        <view class="dj-discovery-name">{{section.name}}</view>
        <view wx:if="{{section.hasBioAtoms}}" class="dj-discovery-atoms">
          <view
            wx:for="{{section.bioAtoms}}"
            wx:for-item="atom"
            wx:key="text"
            class="dj-discovery-atom"
          >
            {{atom.text}}
          </view>
        </view>
        <view wx:if="{{section.hasLinks}}" class="dj-discovery-links">
          <view
            wx:for="{{section.links}}"
            wx:for-item="link"
            wx:key="itemId"
            class="dj-discovery-link"
            data-url="{{link.url}}"
            bindtap="copyDiscoveryLink"
          >
            <view class="dj-discovery-link-main">
              <text class="dj-discovery-link-label">{{link.displayLabel}}</text>
              <text class="dj-discovery-link-platform">{{link.platform}}</text>
            </view>
            <text class="dj-discovery-copy">{{t.copyLink}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-action">
      <button class="icon-button" bindtap="saveItem">
        <image lazy-load class="action-icon" src="{{saved ? '/assets/icons/favorite-active.png' : '/assets/icons/favorite.png'}}" mode="aspectFit" ></image>
        <text>{{saved ? t.saved : t.save}}</text>
      </button>
    </view>
  </view>
</view>
