<view class="page sub-page">
  <view class="sub-nav">
    <button bindtap="goBack">{{t.back}}</button>
  </view>
  <view wx:if="{{loading}}" class="state">{{t.loading}}</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>
  <view wx:else>
      <view class="sub-head">
        <view class="sub-label">{{t.venue}}</view>
        <view class="sub-title">{{name}}</view>
        <view wx:if="{{address}}" class="sub-address" bindtap="handleAddressTap">{{address}}</view>
        <view class="sub-count">{{events.length}} {{t.clubUpcoming}}</view>
        <view wx:if="{{venueSummary}}" class="sub-count venue-scene">{{venueSummary}}</view>
      </view>
    <view class="section" wx:if="{{clubOverviews.length}}">
      <view class="sub-heading">{{t.clubOverviews}}</view>
      <view class="club-overview-list">
        <view
          wx:for="{{clubOverviews}}"
          wx:key="id"
          class="club-overview-card"
          data-url="{{item.originalUrl}}"
          bindtap="openClubOverview"
        >
          <image
            wx:if="{{item.coverUrl && !item.posterLoadFailed}}"
            class="club-overview-poster"
            src="{{item.coverUrl}}"
            mode="aspectFill"
            lazy-load="true"
            data-id="{{item.id}}"
            binderror="onClubOverviewPosterError"
          ></image>
          <view wx:else class="club-overview-poster club-overview-poster-fallback">
            <text>{{item.kindLabel}}</text>
          </view>
          <view class="club-overview-body">
            <view class="club-overview-kicker">
              <text class="club-overview-tag kind-{{item.windowKind}}">{{item.kindLabel}}</text>
              <text class="club-overview-window">{{item.windowLabel}}</text>
            </view>
            <view class="club-overview-title">{{item.title}}</view>
            <view class="club-overview-meta">{{item.publishDate}} · {{t.openOriginal}}</view>
          </view>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>
    <view class="section" wx:if="{{sourceArticles.length}}">
      <view class="source-article-list">
        <view class="sub-heading">{{t.sourceArticles}}</view>
        <view
          wx:for="{{sourceArticles}}"
          wx:key="id"
          class="source-article-row"
          data-hash="{{item.hash}}"
          data-id="{{item.fallbackDetailId}}"
          bindtap="openSourceArticle"
        >
          <view>
            <view class="source-article-title">{{item.title}}</view>
            <view class="source-article-meta">{{item.subtitle}}</view>
          </view>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>
    <view class="section" wx:if="{{events.length}}">
      <view class="sub-heading">{{t.clubSchedule}}</view>
      <view
        wx:for="{{events}}"
        wx:key="id"
        class="event-row"
        data-id="{{item.id}}"
        data-is-atlas="{{item.isAtlasEvent}}"
        data-source-hash="{{item.sourceRefId || item.sourceHash || item.source_ref_id || item.source_hash}}"
        bindtap="openDetail"
      >
        <view>
          <view class="event-title">{{item.displayTitle}}</view>
          <view wx:if="{{!item.isSourceOverview}}" class="event-meta">
            <text wx:if="{{item.isCalendarPreview}}">{{item.calendarPreviewLabel}} · </text>{{item.dateRangeLabel || item.dateLabel}} · {{item.lineupLabel}}
          </view>
        </view>
        <text class="chevron">›</text>
      </view>
    </view>
    <view class="section" wx:if="{{pastEvents.length}}">
      <view class="sub-heading">{{t.clubPastEvents}}</view>
      <view
        wx:for="{{pastEvents}}"
        wx:key="id"
        class="event-row"
        data-id="{{item.id}}"
        data-is-atlas="{{item.isAtlasEvent}}"
        data-source-hash="{{item.sourceRefId || item.sourceHash || item.source_ref_id || item.source_hash}}"
        bindtap="openDetail"
      >
        <view>
          <view class="event-title">{{item.displayTitle}}</view>
          <view wx:if="{{!item.isSourceOverview}}" class="event-meta">
            <text wx:if="{{item.isCalendarPreview}}">{{item.calendarPreviewLabel}} · </text>{{item.dateRangeLabel || item.dateLabel}} · {{item.lineupLabel}}
          </view>
        </view>
        <text class="chevron">›</text>
      </view>
    </view>
    <!-- Resident DJs -->
    <view class="section" wx:if="{{atlasResidentDJs.length}}">
      <view class="sub-heading">经常来的 DJ</view>
      <view class="chip-row">
        <view wx:for="{{atlasResidentDJs}}" wx:key="djId" class="chip collab-chip" catchtap="openArtist" data-name="{{item.displayName}}">
          <text class="chip-name">{{item.displayName}}</text>
          <text class="chip-count">{{item.eventCount}}场</text>
        </view>
      </view>
    </view>
    <view class="section" wx:if="{{aboutLines.length}}">
      <view class="sub-heading">{{t.about}}</view>
      <view wx:for="{{aboutLines}}" wx:key="*this" class="body-line">{{item}}</view>
    </view>
  </view>
</view>
