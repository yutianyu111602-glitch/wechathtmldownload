.atlas-page {
  position: relative;
  min-height: 100vh;
  padding: 0 0 48rpx;
  background: radial-gradient(circle at 50% 16%, #11141f 0%, #05060b 62%);
  color: #e8ecff;
  overflow: hidden;
}

/* 背景星场：纯 CSS 散点 + 呼吸闪烁，营造星系纵深 */
.starfield {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 760rpx;
  pointer-events: none;
  z-index: 0;
}
.star-dot {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #cdd6ff;
  opacity: 0.4;
  animation: twinkle 3.6s ease-in-out infinite;
}
.star-dot.s1 { left: 12%; top: 14%; animation-delay: 0s; }
.star-dot.s2 { left: 78%; top: 10%; width: 6rpx; height: 6rpx; animation-delay: 0.6s; }
.star-dot.s3 { left: 30%; top: 30%; animation-delay: 1.1s; }
.star-dot.s4 { left: 66%; top: 36%; width: 5rpx; height: 5rpx; animation-delay: 1.7s; }
.star-dot.s5 { left: 18%; top: 52%; animation-delay: 2.2s; }
.star-dot.s6 { left: 86%; top: 56%; animation-delay: 0.3s; }
.star-dot.s7 { left: 48%; top: 64%; width: 5rpx; height: 5rpx; animation-delay: 1.4s; }
.star-dot.s8 { left: 8%; top: 72%; animation-delay: 2.6s; }
@keyframes twinkle {
  0%, 100% { opacity: 0.18; transform: scale(0.8); }
  50% { opacity: 0.7; transform: scale(1.2); }
}

.atlas-head {
  position: relative;
  z-index: 1;
  padding: 40rpx 36rpx 12rpx;
}
.atlas-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.atlas-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.atlas-collected {
  flex: none;
  font-size: 20rpx;
  color: #ffce8a;
  letter-spacing: 1rpx;
}
.atlas-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #8a93c8;
}
.atlas-intro {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #aab2dd;
}

.atlas-entry-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.atlas-starmap-entry,
.atlas-search-entry {
  flex: none;
  padding: 12rpx 22rpx;
  border-radius: 6rpx;
  font-size: 23rpx;
  line-height: 1.2;
}

.atlas-starmap-entry {
  border: 1rpx solid rgba(167,255,38,0.30);
  background: rgba(167,255,38,0.12);
  color: #a7ff26;
}

.atlas-search-entry {
  border: 1rpx solid rgba(126,184,218,0.28);
  background: rgba(126,184,218,0.10);
  color: #7eb8da;
}

.seed-bar {
  position: relative;
  z-index: 1;
  width: 100%;
  white-space: nowrap;
  padding: 10rpx 0 0;
}
.seed-track {
  display: inline-flex;
  gap: 14rpx;
  padding: 8rpx 36rpx;
}
.seed-chip {
  flex: none;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(120, 140, 255, 0.12);
  border: 1rpx solid rgba(140, 160, 255, 0.25);
  font-size: 24rpx;
  color: #cfd6ff;
}
.seed-chip-on {
  background: rgba(140, 170, 255, 0.34);
  border-color: rgba(180, 200, 255, 0.65);
  color: #fff;
}
.seed-chip-lit {
  border-color: rgba(255, 206, 138, 0.6);
}
.seed-chip-lit::after {
  content: " ✦";
  color: #ffce8a;
  font-size: 20rpx;
}
.chip-hover {
  opacity: 0.65;
}
.seed-hint {
  position: relative;
  z-index: 1;
  padding: 6rpx 36rpx 0;
  font-size: 20rpx;
  color: #6b73a8;
}

/* 探索轨迹面包屑：点任意一跳回到那一层 */
.trail-bar {
  position: relative;
  z-index: 1;
  width: 100%;
  white-space: nowrap;
  padding: 14rpx 0 0;
}
.trail-track {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 0 36rpx;
}
.trail-chip {
  flex: none;
  max-width: 220rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  font-size: 21rpx;
  color: #aab2dd;
  overflow: hidden;
  text-overflow: ellipsis;
}
.trail-chip-on {
  background: rgba(140, 170, 255, 0.28);
  color: #fff;
}
.trail-arrow {
  flex: none;
  color: #5b6390;
  font-size: 22rpx;
}

.atlas-state {
  position: relative;
  z-index: 1;
  margin: 90rpx 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a93c8;
}
.atlas-state.error {
  color: #ff9a9a;
}

.graph-stage {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 600rpx;
  margin-top: 12rpx;
  transition: opacity 0.25s ease;
}
/* 漫游到下一颗星时不清空旧图，只柔和变暗，避免每次点击都白屏闪烁 */
.graph-loading {
  opacity: 0.45;
  pointer-events: none;
}

.dead-end-hint {
  position: relative;
  z-index: 1;
  margin: 4rpx 48rpx 0;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a93c8;
}
/* 中心脉冲光晕 */
.center-halo {
  position: absolute;
  left: 50%;
  top: 44%;
  width: 220rpx;
  height: 220rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(130, 155, 255, 0.28), rgba(130, 155, 255, 0));
  animation: halo 3.2s ease-in-out infinite;
  z-index: 1;
}
@keyframes halo {
  0%, 100% { transform: translate(-50%, -50%) scale(0.85); opacity: 0.5; }
  50% { transform: translate(-50%, -50%) scale(1.15); opacity: 0.9; }
}
.graph-link {
  position: absolute;
  left: 50%;
  top: 44%;
  height: 2rpx;
  transform-origin: 0 50%;
  background: linear-gradient(90deg, rgba(150, 170, 255, 0.7), rgba(150, 170, 255, 0));
  z-index: 1;
}
.graph-center {
  position: absolute;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  text-align: center;
  z-index: 3;
}
.graph-center.center-dj {
  background: radial-gradient(circle, rgba(120, 150, 255, 0.92), rgba(80, 100, 220, 0.32));
  box-shadow: 0 0 44rpx rgba(120, 150, 255, 0.6);
}
.graph-center.center-venue {
  background: radial-gradient(circle, rgba(255, 170, 90, 0.92), rgba(220, 120, 60, 0.32));
  box-shadow: 0 0 44rpx rgba(255, 170, 90, 0.6);
}
.graph-center.center-org {
  background: radial-gradient(circle, rgba(111, 227, 194, 0.92), rgba(60, 180, 150, 0.32));
  box-shadow: 0 0 44rpx rgba(111, 227, 194, 0.6);
}
.center-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  padding: 0 10rpx;
}
.center-city {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.82);
}

.graph-node {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 150rpx;
  z-index: 2;
}
.node-dot {
  border-radius: 50%;
  margin-bottom: 6rpx;
}
/* 关系越强（tier-strong）越亮，弱关系收敛亮度 —— 渲染出强度差 */
.node-dj .node-dot {
  background: #8ea2ff;
}
.node-venue .node-dot {
  background: #ffb066;
}
.node-dj.tier-strong .node-dot { box-shadow: 0 0 26rpx rgba(140, 162, 255, 0.95); }
.node-dj.tier-mid .node-dot { box-shadow: 0 0 16rpx rgba(140, 162, 255, 0.7); }
.node-dj.tier-weak .node-dot { background: #6f80c8; box-shadow: 0 0 8rpx rgba(140, 162, 255, 0.4); }
.node-venue.tier-strong .node-dot { box-shadow: 0 0 26rpx rgba(255, 176, 102, 0.95); }
.node-venue.tier-mid .node-dot { box-shadow: 0 0 16rpx rgba(255, 176, 102, 0.7); }
.node-venue.tier-weak .node-dot { background: #c88a52; box-shadow: 0 0 8rpx rgba(255, 176, 102, 0.4); }
/* 主办/厂牌节点：青绿色，和 DJ(蓝)/俱乐部(橙)区分开 */
.node-org .node-dot {
  background: #6fe3c2;
}
.node-org.tier-strong .node-dot { box-shadow: 0 0 26rpx rgba(111, 227, 194, 0.95); }
.node-org.tier-mid .node-dot { box-shadow: 0 0 16rpx rgba(111, 227, 194, 0.7); }
.node-org.tier-weak .node-dot { background: #4fb89a; box-shadow: 0 0 8rpx rgba(111, 227, 194, 0.4); }
.node-lit .node-dot {
  border: 2rpx solid rgba(255, 235, 200, 0.9);
}
.node-label {
  max-width: 150rpx;
  font-size: 21rpx;
  color: #dfe4ff;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.node-meta {
  margin-top: 2rpx;
  font-size: 17rpx;
  color: #7e88bd;
}
.node-hover {
  opacity: 0.6;
}

.center-panel {
  position: relative;
  z-index: 1;
  margin: 10rpx 36rpx 0;
  text-align: center;
}
.center-stats {
  font-size: 23rpx;
  color: #aab2dd;
}
.center-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 18rpx;
  justify-content: center;
}
.ctl-btn {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(120, 140, 255, 0.16);
  border: 1rpx solid rgba(140, 160, 255, 0.3);
  font-size: 23rpx;
  color: #cfd6ff;
}
.ctl-link {
  background: rgba(255, 170, 90, 0.16);
  border-color: rgba(255, 170, 90, 0.35);
  color: #ffcb96;
}
.ctl-random {
  background: rgba(150, 130, 255, 0.16);
  border-color: rgba(170, 150, 255, 0.35);
  color: #d6c8ff;
}

.events-panel {
  position: relative;
  z-index: 1;
  margin: 28rpx 36rpx 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.panel-title {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #cfd6ff;
}
.event-row {
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}
.event-row:first-child {
  border-top: none;
}
.event-title {
  font-size: 24rpx;
  color: #e8ecff;
}
.event-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8a93c8;
}

/* 我的足迹卡 (plan 101 #8) */
.footprint-block {
  margin: 16rpx 24rpx 0;
}
.footprint-cta {
  text-align: center;
  padding: 18rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #ffce8a;
  border: 1rpx solid rgba(255, 206, 138, 0.30);
  background: rgba(255, 206, 138, 0.10);
}
.footprint-cta.is-loading {
  opacity: 0.6;
}
.footprint-card {
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(140, 160, 255, 0.22);
  background: rgba(120, 140, 255, 0.08);
}
.footprint-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.footprint-title {
  font-size: 26rpx;
  color: #e8ecff;
  font-weight: 600;
}
.footprint-stat {
  font-size: 22rpx;
  color: #ffce8a;
}
.footprint-cities {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.footprint-city {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(126, 184, 218, 0.10);
  border: 1rpx solid rgba(126, 184, 218, 0.28);
}
.footprint-city-name {
  font-size: 22rpx;
  color: #7eb8da;
}
.footprint-city-count {
  font-size: 18rpx;
  color: #8a93c8;
}
.footprint-djs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.footprint-dj {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #cfd6ff;
  background: rgba(120, 140, 255, 0.12);
  border: 1rpx solid rgba(140, 160, 255, 0.25);
}
.footprint-hint {
  margin-top: 14rpx;
  font-size: 18rpx;
  color: #8a93c8;
}

.footprint-share-btn {
  margin-top: 20rpx;
  background: rgba(126,184,218,0.12);
  color: rgba(126,184,218,0.85);
  border: 1rpx solid rgba(126,184,218,0.25);
  border-radius: 8rpx;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
  width: 100%;
}
