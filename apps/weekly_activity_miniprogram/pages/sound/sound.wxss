.sound-page { background:#050505; min-height:100vh; display:flex; flex-direction:column; }
.sound-nav { display:flex; align-items:center; padding:12rpx 24rpx; gap:16rpx; background:#0a0a0a; }
.nav-back { color:#999; font-size:28rpx; padding:8rpx 12rpx; }
.sound-nav-title { color:#fff; font-size:30rpx; font-weight:600; flex:1; }

.sound-body { flex:1; padding:0 32rpx 80rpx; }

.sound-intro { margin-top:32rpx; padding:28rpx; border:1rpx solid rgba(191,244,94,.18); border-radius:8rpx; background:linear-gradient(180deg, rgba(191,244,94,.06), rgba(255,255,255,.02)); }
.sound-intro-title { color:#e9e5cf; font-size:28rpx; font-weight:700; margin-bottom:14rpx; }
.sound-intro-copy { color:rgba(255,255,255,.58); font-size:24rpx; line-height:1.58; }

.form-section { margin-top:36rpx; }
.section-label { color:rgba(255,255,255,.82); font-size:26rpx; font-weight:600; margin-bottom:14rpx; }
.required { color:#ff6b35; }

.image-grid { display:flex; flex-wrap:wrap; gap:16rpx; }
.image-cell { position:relative; width:156rpx; height:156rpx; border-radius:6rpx; overflow:hidden; border:1rpx solid rgba(255,255,255,.08); }
.image-thumb { width:100%; height:100%; }
.image-remove { position:absolute; top:0; right:0; width:44rpx; height:44rpx; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,.7); color:#ff4444; font-size:32rpx; line-height:1; }
.image-add { display:flex; flex-direction:column; align-items:center; justify-content:center; background:rgba(255,255,255,.04); gap:8rpx; }
.add-icon { color:rgba(255,255,255,.32); font-size:48rpx; line-height:1; }
.add-label { color:rgba(255,255,255,.28); font-size:20rpx; }
.field-hint { margin-top:10rpx; color:rgba(255,255,255,.28); font-size:22rpx; }

.sound-input { width:100%; height:80rpx; padding:0 20rpx; border:1rpx solid rgba(255,255,255,.08); border-radius:6rpx; background:rgba(255,255,255,.04); color:#e0e0e0; font-size:26rpx; box-sizing:border-box; }
.sound-textarea { width:100%; min-height:140rpx; padding:18rpx 20rpx; border:1rpx solid rgba(255,255,255,.08); border-radius:6rpx; background:rgba(255,255,255,.04); color:#e0e0e0; font-size:26rpx; box-sizing:border-box; }

.submit-btn { width:100%; height:88rpx; margin-top:48rpx; border:none; border-radius:8rpx; background:linear-gradient(135deg, #b6ff3b, #8fdc65); color:#0a0a0a; font-size:30rpx; font-weight:700; }
.submit-btn[disabled] { opacity:.42; }

.history-section { margin-top:56rpx; padding-top:40rpx; border-top:1rpx solid rgba(255,255,255,.06); }
.history-card { margin-top:20rpx; padding:24rpx; border:1rpx solid rgba(255,255,255,.06); border-radius:6rpx; background:rgba(255,255,255,.02); }
.history-head { display:flex; justify-content:space-between; align-items:center; }
.history-club { color:#e9e5cf; font-size:26rpx; font-weight:600; }
.history-remove { color:#ff4444; font-size:22rpx; }
.history-meta { margin-top:10rpx; color:rgba(255,255,255,.42); font-size:22rpx; }
.history-status { color:rgba(182,255,59,.68); }
.history-status-warning { color:#ffb44a; }
.history-images { margin-top:12rpx; color:#b6ff3b; font-size:22rpx; }
