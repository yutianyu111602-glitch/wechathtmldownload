.sm-root { position: relative; width: 100vw; height: 100vh; background: #05070d; overflow: hidden; }
.sm-canvas { width: 100vw; height: 100vh; display: block; }

.sm-top { position: absolute; top: 0; left: 0; right: 0; padding: 16rpx 20rpx; display: flex; flex-direction: column; gap: 12rpx; }
.sm-lenses { display: flex; gap: 10rpx; }
.sm-lens { padding: 8rpx 20rpx; border-radius: 24rpx; font-size: 22rpx; color: #9fb3c8; background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.08); }
.sm-lens.on { color: #05070d; background: #A7FF26; border-color: #A7FF26; font-weight: 600; }
.sm-search { height: 60rpx; padding: 0 22rpx; border-radius: 30rpx; background: rgba(255,255,255,0.06); border: 1rpx solid rgba(255,255,255,0.10); color: #e8f0f8; font-size: 24rpx; }
.sm-ph { color: #5a6b7a; }

.sm-hud { position: absolute; left: 20rpx; bottom: 24rpx; font-size: 20rpx; color: rgba(255,255,255,0.30); font-family: monospace; }
.sm-loading { position: absolute; top: 50%; left: 0; right: 0; text-align: center; color: rgba(255,255,255,0.5); font-size: 26rpx; }

.sm-notice { position: absolute; left: 20rpx; right: 20rpx; top: 176rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: rgba(167,255,38,0.10); border: 1rpx solid rgba(167,255,38,0.25); color: #cde8a0; font-size: 22rpx; line-height: 1.5; }

.sm-card { position: absolute; left: 20rpx; right: 20rpx; bottom: 56rpx; padding: 24rpx; border-radius: 18rpx; background: rgba(7,18,24,0.96); border: 1rpx solid rgba(255,255,255,0.10); }
.sm-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.sm-card-name { font-size: 30rpx; font-weight: 600; color: #f0f6fb; }
.sm-card-x { font-size: 36rpx; color: rgba(255,255,255,0.4); padding: 0 8rpx; line-height: 1; }
.sm-card-meta { display: flex; gap: 12rpx; flex-wrap: wrap; margin-bottom: 16rpx; }
.sm-tag { font-size: 22rpx; color: #9fb3c8; background: rgba(255,255,255,0.05); border: 1rpx solid rgba(255,255,255,0.08); border-radius: 8rpx; padding: 6rpx 14rpx; }
.sm-card-act { font-size: 24rpx; color: #A7FF26; }
.sm-card-brk { font-size: 22rpx; color: #9fb3c8; margin-bottom: 14rpx; line-height: 1.5; }

.sm-legend { display: flex; gap: 14rpx; flex-wrap: wrap; }
.sm-leg { display: flex; align-items: center; gap: 6rpx; font-size: 20rpx; color: #c2d2e0; padding: 4rpx 12rpx; border-radius: 18rpx; background: rgba(255,255,255,0.04); border: 1rpx solid rgba(255,255,255,0.06); }
.sm-leg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.sm-leg-off { opacity: 0.32; text-decoration: line-through; }

.sm-ctrls { position: absolute; right: 20rpx; bottom: 64rpx; display: flex; flex-direction: column; gap: 12rpx; align-items: flex-end; }
.sm-ctrl { font-size: 22rpx; color: #cfe0ee; padding: 10rpx 20rpx; border-radius: 26rpx; background: rgba(7,18,24,0.85); border: 1rpx solid rgba(255,255,255,0.10); }
