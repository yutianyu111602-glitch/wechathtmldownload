<view class="page home-page">
  <view class="home-hero">
    <view class="topbar">
      <image lazy-load class="brand-logo" src="/assets/brand/huaidj-logo-nav-512x128.png" mode="aspectFit" ></image>
      <view class="topbar-actions">
        <view class="map-entry" bindtap="openMap" hover-class="option-hover">
          <text class="map-entry-icon">◉</text>
          <text class="map-entry-label">MAP</text>
        </view>
        <button class="lang-toggle" bindtap="toggleLang">{{t.langToggle}}</button>
      </view>
    </view>

    <view class="hero-copy">
      <view class="hero-kicker">{{t.brandKicker}}</view>
      <view class="hero-title">{{heroTitle}}</view>
      <view class="hero-meta">{{cacheNotice || loadingStep || t.loadingReady}}</view>
    </view>

    <view class="filter-console">
      <view class="filter-main-row">
        <view class="filter-control filter-control-city" hover-class="option-hover" bindtap="openLocationModal">
          <view class="filter-control-copy">
            <text class="filter-label">{{t.locationTitle}}</text>
            <text class="filter-value">{{cityPillLabel}}</text>
          </view>
          <text class="pill-arrow">›</text>
        </view>
        <view class="filter-control filter-control-date filter-control-primary" hover-class="option-hover" bindtap="openDateModal">
          <view class="filter-control-copy">
            <text class="filter-label">{{t.dateTitle}}</text>
            <text class="filter-value">{{datePillLabel}}</text>
          </view>
          <text class="pill-arrow">›</text>
        </view>
      </view>
      <view class="date-shortcuts">
        <view class="date-shortcut {{dateMode === 'all_current' ? 'date-shortcut-active' : ''}}" hover-class="option-hover" bindtap="resetDate">{{t.resetToday}}</view>
        <view class="date-shortcut {{dateMode === 'this_weekend' ? 'date-shortcut-active' : ''}}" hover-class="option-hover" bindtap="chooseThisWeekend">{{t.thisWeekend}}</view>
        <view class="date-shortcut {{dateMode === 'next_weekend' ? 'date-shortcut-active' : ''}}" hover-class="option-hover" bindtap="chooseNextWeekend">{{t.nextWeekend}}</view>
      </view>
      <view class="filter-scope-line">
        <view class="filter-scope-copy"><text class="filter-scope-dot"></text><text>{{cityPillLabel}}</text></view>
        <view wx:if="{{selectedCity}}" class="filter-reset-link" hover-class="option-hover" bindtap="resetLocation">{{t.resetLocation}}</view>
      </view>
    </view>
    <view wx:if="{{localCityKey && !selectedCity}}" class="loc-boost-chip" bindtap="applyLocalCityFilter" hover-class="option-hover">
      <text class="loc-boost-dot">◉</text><text>{{localCityLabel}} 优先</text>
    </view>

    <view class="tabs">
      <view data-tab="all" bindtap="setTab" class="{{activeTab === 'all' ? 'tab-active' : ''}}">{{t.tabAll}}</view>
      <view data-tab="forYou" bindtap="setTab" class="{{activeTab === 'forYou' ? 'tab-active' : ''}}">{{t.tabForYou}}</view>
      <view data-tab="new" bindtap="setTab" class="{{activeTab === 'new' ? 'tab-active' : ''}}">{{t.tabNew}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-panel">
    <view class="loading-row">
      <text>{{t.loading}}</text>
      <text>{{loadingProgress}}%</text>
    </view>
    <view class="loading-track">
      <view class="loading-bar" style="width: {{loadingProgress}}%;"></view>
    </view>
    <view class="loading-step">{{loadingStep}}</view>
    <view wx:if="{{loadingHint}}" class="loading-hint">{{loadingHint}}</view>
  </view>
  <view wx:elif="{{error}}" class="state error">
    <view>{{error}}</view>
    <view wx:if="{{errorHint}}" class="state-hint">{{errorHint}}</view>
    <button class="retry-button" hover-class="option-hover" bindtap="retryLoadData">{{t.retry}}</button>
  </view>
  <view wx:elif="{{totalItems === 0}}" class="state">{{t.empty}}</view>

  <view wx:else class="home-content" bindtouchstart="onFeedTouchStart" bindtouchmove="onFeedTouchMove">
    <view wx:if="{{cacheNotice}}" class="cache-notice">{{cacheNotice}}</view>
    <view class="archive-heading">{{t.featured}}</view>

    <scroll-view class="poster-strip" scroll-x enable-flex bindscroll="onPosterStripScroll">
      <view wx:for="{{popularItems}}" wx:key="posterKey" class="poster-card" data-id="{{item.id}}" bindtap="openDetail" hover-class="poster-hover">
        <view class="poster-frame">
          <image wx:if="{{item.coverUrl && !item.posterLoadFailed}}" class="event-poster" src="{{item.coverUrl}}" mode="aspectFill" data-id="{{item.id}}" data-src="{{item.coverUrl}}" bindload="onPosterImageLoad" binderror="onPosterImageError" ></image>
          <view wx:else class="poster-fallback">{{item.displayTitle}}</view>
        </view>
        <view class="poster-date">
          <text wx:if="{{item.isCalendarPreview}}" class="calendar-preview-tag">{{item.calendarPreviewLabel}}</text>
          <text>{{item.weekdayLabel}}, {{item.dateRangeCompact || item.dateCompact}}</text>
        </view>
        <view class="poster-title">{{item.displayTitle}}</view>
        <view class="poster-meta">{{item.cardLocationLabel}}</view>
        <view wx:if="{{item.hasPrice}}" class="poster-price">{{item.priceLabel}}</view>
        <view wx:if="{{item.hasStyle}}" class="poster-meta">{{item.styleLabel}}</view>
      </view>
    </scroll-view>

    <view class="archive-heading all-heading">{{t.allEvents}}</view>
    <view wx:for="{{groups}}" wx:key="key" class="day-group">
      <view class="day-head">
        <text>{{item.weekday}}</text>
        <text>{{item.date}}</text>
      </view>
      <view wx:for="{{item.items}}" wx:for-item="event" wx:key="id" class="event-row" data-id="{{event.id}}" bindtap="openDetail">
        <view class="event-date">
          <view class="event-weekday">{{event.weekdayLabel}}</view>
          <view class="event-day">{{event.dateRangeCompact || event.dateCompact}}</view>
        </view>
        <view class="event-main">
          <view wx:if="{{event.isCalendarPreview}}" class="event-tag">{{event.calendarPreviewLabel}}</view>
          <view class="event-title">{{event.displayTitle}}</view>
          <view class="event-place">{{event.listLocationLabel}}</view>
          <view wx:if="{{event.hasLineup}}" class="event-lineup">{{event.lineupLabel}}</view>
          <view wx:elif="{{event.hasLineupHint}}" class="event-lineup event-lineup-hint">{{event.lineupHint}}</view>
          <view wx:if="{{event.hasPrice}}" class="event-price">{{event.priceLabel}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showDateModal}}" class="modal-backdrop" bindtap="closeModal">
    <view class="logic-modal" catchtap="noop">
      <view class="modal-head">
        <view class="modal-title">{{t.dateTitle}}</view>
        <view bindtap="closeModal" class="modal-close">×</view>
      </view>
      <view class="date-grid">
        <view
          wx:for="{{dateFilters}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="chooseDraftDate"
          hover-class="option-hover"
          class="modal-option {{selectedDate === item.key ? 'modal-option-active' : ''}}"
        >
          <text>{{item.label}}</text>
          <text wx:if="{{item.count}}" class="option-count">{{item.count}}</text>
        </view>
      </view>
      <view class="quick-row">
        <view class="quick-pill" hover-class="option-hover" bindtap="chooseThisWeekend">{{t.thisWeekend}}</view>
        <view class="quick-pill" hover-class="option-hover" bindtap="chooseNextWeekend">{{t.nextWeekend}}</view>
      </view>
      <view class="modal-actions">
        <view class="reset-button" hover-class="option-hover" bindtap="resetDate">{{t.resetToday}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{showLocationModal}}" class="modal-backdrop" bindtap="closeModal">
    <view class="logic-modal" catchtap="noop">
      <view class="modal-head">
        <view class="modal-title">{{t.locationTitle}}</view>
        <view bindtap="closeModal" class="modal-close">×</view>
      </view>
      <scroll-view class="location-tree" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="country-row">{{t.china}}<text class="chevron">›</text></view>
        <view
          wx:for="{{cityFilters}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="chooseDraftCity"
          hover-class="option-hover"
          class="city-row {{selectedCity === item.key ? 'city-row-active' : ''}}"
        >
          <text>{{item.label}}</text>
          <text wx:if="{{item.count}}" class="option-count">{{item.count}}</text>
        </view>
      </scroll-view>
      <view class="modal-actions">
        <view class="reset-button wide" hover-class="option-hover" bindtap="resetLocation">{{t.resetLocation}}</view>
      </view>
    </view>
  </view>
</view>
