.column-page {
  padding: 24rpx 28rpx 120rpx;
  background: #050505;
  min-height: 100vh;
  color: #ddd;
}

.brand-logo {
  width: 300rpx;
  height: 60rpx;
  margin: 20rpx 0 32rpx;
}

.column-header {
  margin-bottom: 40rpx;
}

.column-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.column-subtitle {
  font-size: 26rpx;
  color: #777;
  margin-top: 12rpx;
  line-height: 1.6;
}

.tag-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.tag-pill {
  font-size: 22rpx;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background: #1a1a1a;
  color: #888;
  border: 1rpx solid #333;
}

.tag-pill-active {
  background: #A7FF26;
  color: #000;
  border-color: #A7FF26;
  font-weight: 600;
}

.column-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.column-card {
  background: #111;
  border: 1rpx solid #222;
  border-radius: 12rpx;
  padding: 0;
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 28rpx 0;
}

.card-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #1a1a1a;
}

.card-header-text {
  flex: 1;
  min-width: 0;
}

.card-body {
  padding: 16rpx 28rpx 28rpx;
}

.card-body-collapsed .card-summary {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-body-expanded .card-summary {
  display: block;
}

.card-expand-icon {
  font-size: 28rpx;
  color: #555;
  padding: 8rpx 12rpx;
  flex-shrink: 0;
}

.column-card-hover {
  background: #1a1a1a;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.card-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.tag-hot { background: #ff2d55; color: #fff; }
.tag-dj { background: #5856d6; color: #fff; }
.tag-event { background: #34c759; color: #000; }
.tag-gear { background: #ff9500; color: #000; }
.tag-label { background: #007aff; color: #fff; }
.tag-city { background: #af52de; color: #fff; }
.tag-trend { background: #ff3b30; color: #fff; }

.card-date {
  font-size: 22rpx;
  color: #555;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.card-summary {
  font-size: 26rpx;
  color: #bbb;
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.card-foreign {
  display: flex;
  gap: 10rpx;
  padding: 14rpx 16rpx;
  background: rgba(126, 184, 218, 0.06);
  border-left: 3rpx solid #7eb8da;
  border-radius: 0 8rpx 8rpx 0;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.foreign-label {
  font-size: 20rpx;
  font-weight: 600;
  color: #7eb8da;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  white-space: nowrap;
  padding-top: 2rpx;
}

.card-source {
  font-size: 22rpx;
  color: #555;
  margin-top: 12rpx;
}

.card-link-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #1a1a1a;
  border-radius: 8rpx;
}

.card-link-icon {
  font-size: 28rpx;
}

.card-link-text {
  flex: 1;
  font-size: 24rpx;
  color: #7eb8da;
}

.card-link-arrow {
  font-size: 28rpx;
  color: #555;
}

.card-link-row-disabled {
  opacity: 0.4;
}

.card-link-row-disabled .card-link-text {
  color: #666;
}

.card-tracks {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #1a1a1a;
}

.card-track-item {
  font-size: 22rpx;
  color: #666;
  line-height: 1.8;
}

.track-dot {
  margin-right: 8rpx;
  color: #444;
}

.card-source::before {
  content: "↗ ";
}

.column-footer {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #222;
  font-size: 22rpx;
  color: #444;
  text-align: center;
}