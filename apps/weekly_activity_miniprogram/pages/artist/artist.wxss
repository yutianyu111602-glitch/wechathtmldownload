.sub-page {
  padding: 0 32rpx 96rpx;
  background: #0a0a0a;
}

.sub-nav {
  height: 92rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid rgba(255,255,255,.05);
}

.sub-nav button {
  margin: 0;
  padding: 0;
  color: rgba(255,255,255,0.32);
  background: transparent;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: .12em;
}

.sub-head {
  padding: 54rpx 0 38rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.sub-label,
.sub-count {
  color: #7eb8da;
  font-size: 24rpx;
  line-height: 1.2;
  letter-spacing: .14em;
}

.sub-title {
  margin-top: 18rpx;
  color: #e0e0e0;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 50rpx;
  line-height: 1.1;
  font-weight: 780;
}

.sub-count {
  margin-top: 22rpx;
  color: rgba(255,255,255,0.32);
}

.date-range {
  margin-top: 8rpx;
  color: rgba(255,255,255,0.22);
  font-size: 22rpx;
}

.interview-cta {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border: 1rpx solid rgba(182,255,59,0.22);
  border-radius: 8rpx;
  background: rgba(182,255,59,0.06);
}

.interview-cta-title {
  color: rgba(255,255,255,.9);
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 720;
}

.interview-cta-copy {
  margin-top: 8rpx;
  color: rgba(255,255,255,.42);
  font-size: 22rpx;
  line-height: 1.36;
}

.interview-cta-arrow {
  color: #b6ff3b;
  font-size: 30rpx;
  line-height: 1;
}

.aliases {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.alias-chip {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: rgba(126,184,218,0.12);
  color: rgba(126,184,218,0.8);
  border-radius: 6rpx;
  font-size: 22rpx;
}

.section {
  padding-top: 52rpx;
}

.sub-heading {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
  color: rgba(255,255,255,.82);
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: .14em;
}

.sub-heading::before {
  display: inline-block;
  width: 6rpx;
  height: 6rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #7eb8da;
  vertical-align: 4rpx;
  content: "";
}

.event-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.event-title {
  color: #e0e0e0;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 30rpx;
  line-height: 1.22;
  font-weight: 750;
}

.event-meta,
.body-line {
  margin-top: 10rpx;
  color: rgba(255,255,255,0.58);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 24rpx;
  line-height: 1.48;
}

.body-line {
  margin-bottom: 24rpx;
}

.bio-source {
  margin-top: -16rpx;
  margin-bottom: 24rpx;
  color: rgba(255,255,255,0.22);
  font-size: 20rpx;
  font-style: italic;
}

.chevron {
  color: rgba(255,255,255,0.32);
  font-size: 44rpx;
  font-weight: 300;
}

.venue-link {
  color: #7eb8da;
}

/* Chips */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 10rpx;
  background: rgba(255,255,255,0.06);
}

.chip-name {
  color: rgba(255,255,255,0.82);
  font-size: 26rpx;
}

.chip-count {
  color: rgba(255,255,255,0.32);
  font-size: 22rpx;
}

.venue-chip {
  border: 1rpx solid rgba(126,184,218,0.25);
}

.collab-chip {
  border: 1rpx solid rgba(255,255,255,0.08);
}
