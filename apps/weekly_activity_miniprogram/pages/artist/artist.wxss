.sub-page {
  padding: 0 32rpx 96rpx;
  background: #0a0a0a;
}

.sub-nav {
  height: 92rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid rgba(255,255,255,.05);
}

.sub-nav button {
  margin: 0;
  padding: 0;
  color: rgba(255,255,255,0.32);
  background: transparent;
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: .12em;
}

.sub-head {
  padding: 54rpx 0 38rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.sub-label,
.sub-count {
  color: #7eb8da;
  font-size: 24rpx;
  line-height: 1.2;
  letter-spacing: .14em;
}

.sub-title {
  margin-top: 18rpx;
  color: #e0e0e0;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 50rpx;
  line-height: 1.1;
  font-weight: 780;
}

.sub-count {
  margin-top: 22rpx;
  color: rgba(255,255,255,0.32);
}

.date-range {
  margin-top: 8rpx;
  color: rgba(255,255,255,0.22);
  font-size: 22rpx;
}

.interview-cta {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border: 1rpx solid rgba(182,255,59,0.22);
  border-radius: 8rpx;
  background: rgba(182,255,59,0.06);
}

.interview-cta-title {
  color: rgba(255,255,255,.9);
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 720;
}

.interview-cta-copy {
  margin-top: 8rpx;
  color: rgba(255,255,255,.42);
  font-size: 22rpx;
  line-height: 1.36;
}

.interview-cta-arrow {
  color: #b6ff3b;
  font-size: 30rpx;
  line-height: 1;
}

.aliases {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.alias-chip {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: rgba(126,184,218,0.12);
  color: rgba(126,184,218,0.8);
  border-radius: 6rpx;
  font-size: 22rpx;
}

.section {
  padding-top: 52rpx;
}

.sub-heading {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
  color: rgba(255,255,255,.82);
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: .14em;
}

.sub-heading::before {
  display: inline-block;
  width: 6rpx;
  height: 6rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #7eb8da;
  vertical-align: 4rpx;
  content: "";
}

.event-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}

.radio-program-row {
  min-height: 124rpx;
}

.radio-program-main {
  min-width: 0;
  padding-right: 20rpx;
}

.event-title {
  color: #e0e0e0;
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 30rpx;
  line-height: 1.22;
  font-weight: 750;
}

.radio-program-title {
  font-size: 28rpx;
}

.event-meta,
.body-line {
  margin-top: 10rpx;
  color: rgba(255,255,255,0.58);
  font-family: "Noto Sans SC", "PingFang SC", sans-serif;
  font-size: 24rpx;
  line-height: 1.48;
}

.radio-program-meta {
  color: rgba(126,184,218,0.72);
  font-family: "JetBrains Mono", "SF Mono", Consolas, monospace;
  font-size: 21rpx;
}

.radio-program-desc {
  margin-top: 8rpx;
  color: rgba(255,255,255,0.42);
  font-size: 22rpx;
  line-height: 1.42;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.support-section {
  padding-top: 44rpx;
}

.support-note {
  margin: -10rpx 0 14rpx;
  color: rgba(255,255,255,0.32);
  font-size: 22rpx;
  line-height: 1.36;
}

.support-section .event-row {
  min-height: 100rpx;
}

.column-row {
  min-height: 148rpx;
  align-items: flex-start;
  padding: 22rpx 0;
}

.column-main {
  min-width: 0;
  padding-right: 20rpx;
}

.column-title {
  font-size: 28rpx;
}

.column-summary {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.column-meta {
  margin-top: 8rpx;
  color: rgba(255,255,255,0.32);
  font-size: 21rpx;
  line-height: 1.35;
}

.column-action {
  margin-top: 12rpx;
  color: rgba(182,255,59,0.82);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.section-toggle {
  margin-top: 18rpx;
  min-height: 76rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid rgba(126,184,218,0.18);
  border-radius: 8rpx;
  color: rgba(126,184,218,0.9);
  background: rgba(126,184,218,0.07);
  font-size: 24rpx;
  font-weight: 680;
}

.section-toggle-arrow {
  color: rgba(255,255,255,0.42);
  font-size: 28rpx;
  line-height: 1;
}

.relation-section {
  padding-top: 48rpx;
}

.trajectory-strip {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.trajectory-city {
  min-width: 0;
  padding: 18rpx 18rpx 16rpx;
  border: 1rpx solid rgba(126,184,218,0.18);
  border-radius: 8rpx;
  background: rgba(126,184,218,0.07);
}

.trajectory-city-active {
  border-color: rgba(126,184,218,0.62);
  background: rgba(126,184,218,0.18);
}

.filter-tag {
  color: rgba(126,184,218,0.85);
  font-weight: 600;
}

.trajectory-city-name {
  color: rgba(255,255,255,0.86);
  font-size: 28rpx;
  font-weight: 760;
  line-height: 1.2;
}

.trajectory-meta {
  margin-top: 8rpx;
  color: rgba(255,255,255,0.38);
  font-family: "JetBrains Mono", "SF Mono", Consolas, monospace;
  font-size: 20rpx;
  line-height: 1.35;
}

.trajectory-group {
  margin-top: 24rpx;
}

.trajectory-label {
  margin-bottom: 14rpx;
  color: rgba(255,255,255,0.34);
  font-size: 22rpx;
  font-weight: 680;
  letter-spacing: .1em;
}

.relation-chip {
  border-color: rgba(182,255,59,0.16);
}

.trajectory-event-row {
  min-height: 104rpx;
}

.trajectory-event-title {
  font-size: 26rpx;
}

.body-line {
  margin-bottom: 24rpx;
}

.bio-source {
  margin-top: -16rpx;
  margin-bottom: 24rpx;
  color: rgba(255,255,255,0.22);
  font-size: 20rpx;
  font-style: italic;
}

.chevron {
  color: rgba(255,255,255,0.32);
  font-size: 44rpx;
  font-weight: 300;
}

.venue-link {
  color: #7eb8da;
}

/* Chips */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 10rpx;
  background: rgba(255,255,255,0.06);
}

.chip-name {
  color: rgba(255,255,255,0.82);
  font-size: 26rpx;
}

.chip-count {
  color: rgba(255,255,255,0.32);
  font-size: 22rpx;
}

.venue-chip {
  border: 1rpx solid rgba(126,184,218,0.25);
}

.collab-chip {
  border: 1rpx solid rgba(255,255,255,0.08);
}

.org-chip {
  border: 1rpx solid rgba(183,148,246,0.30);
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 20rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(255,255,255,.12);
  border-top-color: rgba(182,255,59,.8);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: rgba(255,255,255,.72);
  font-size: 30rpx;
  font-weight: 600;
}

.loading-hint {
  color: rgba(255,255,255,.36);
  font-size: 24rpx;
}

/* Outlink grouped display */
.outlink-role-group {
  margin-bottom: 16rpx;
}
.outlink-role-label {
  color: rgba(255,255,255,0.32);
  font-size: 22rpx;
  letter-spacing: .12em;
  text-transform: uppercase;
  padding: 8rpx 0 4rpx;
}
.outlink-primary-row {
  padding-left: 12rpx;
}
.outlink-count-note {
  color: rgba(126,184,218,0.55);
  font-size: 22rpx;
}

.bio-candidate-text { color: rgba(255,255,255,0.52); }
.bio-candidate-badge { color: rgba(250,204,21,0.65); font-size: 20rpx; margin-top: 8rpx; letter-spacing: .06em; }

.listen-hub { background: rgba(126,184,218,0.07); border-radius: 12rpx; padding: 16rpx 20rpx 10rpx; margin-bottom: 20rpx; }
.listen-hub .outlink-role-label { color: rgba(126,184,218,0.9); font-size: 24rpx; }
.listen-hub .outlink-primary-row { background: rgba(126,184,218,0.06); border-radius: 8rpx; margin-bottom: 8rpx; }
